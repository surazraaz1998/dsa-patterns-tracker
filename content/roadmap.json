  "playbook": {
    "dsa": [
      "Start with the brute force.",
      "Discuss time and space complexity out loud.",
      "Say clearly why the brute force breaks at large input.",
      "Optimise step by step from the brute-force baseline.",
      "Most important: dry-run your code on the given input before submitting."
    ],
    "hld": [
      "Gather functional and non-functional requirements first.",
      "Most important: back-of-the-envelope estimates early.",
      "Design a basic working flow, then make it extendable.",
      "Discuss scaling and cross-region setups in depth — interviewers love this.",
      "Don't rush into the design; it hurts more than it helps.",
      "Keep the interviewer involved so they feel part of the design and ask fewer surprise questions."
    ],
    "lld": [
      "Start with a UML class diagram.",
      "Don't over-ask — the interviewer will usually say yes to everything; make sensible assumptions.",
      "Start with a basic model, then extend it and make it scalable.",
      "Explain concurrency while coding — interviewers care most about this.",
      "Discuss race conditions and add locking where needed.",
      "Naming matters a lot — make every class and method name obvious."
    ]
  }
