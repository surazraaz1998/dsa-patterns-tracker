{
  "title": "6-Month Interview Roadmap",
  "subtitle": "DSA · High & Low-Level Design · Agentic AI — three tracks in parallel, ~14–16 hrs/week (≈6 DSA, 5 design, 4–5 AI).",
  "phases": [
    {
      "id": 1,
      "name": "Foundations",
      "weeks": "1-8",
      "goal": "Strong DSA fundamentals, OOP/SOLID with your first LLD builds, and a working MCP server.",
      "checkpoint": "You can design Parking Lot and Vending Machine cleanly with patterns named out loud, you're comfortable up to Trees/BST, and your MCP server answers one real query end to end."
    },
    {
      "id": 2,
      "name": "Core Build",
      "weeks": "9-16",
      "goal": "Mid-level LLD/HLD case studies solved confidently, and a live agent with a streaming chat UI.",
      "checkpoint": "Your assistant runs a real agent over MCP + RAG. You can whiteboard 4 HLD and 6 LLD systems from memory."
    },
    {
      "id": 3,
      "name": "Interview-Ready",
      "weeks": "17-24",
      "goal": "Full interview-loop readiness across all tracks, plus production signals (evals, observability, guardrails) on your AI project.",
      "checkpoint": "Loop-ready: DSA (brute force → optimised, dry-run discipline), HLD (requirements → estimation → design → scaling), LLD (UML → SOLID → concurrency-aware code), and a shipped, evaluated AI project."
    }
  ],
