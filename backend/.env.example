# Copy this file to .env in the backend folder for local runs.

# Database URL (For single source of truth, set your hosted PostgreSQL URL here, e.g. postgresql://user:pass@host/dbname)
# Leave empty to use a local SQLite file (backend/dsa_tracker.db)
DATABASE_URL=


# JWT secret — use a long random value in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me

# EDITH voice tutor — paused. Set EDITH_ENABLED=true here AND VITE_EDITH_ENABLED=true for the frontend build to bring it back.
EDITH_ENABLED=false
# AI mode needs a key; without one EDITH runs in offline script mode.
ANTHROPIC_API_KEY=
# EDITH_MODEL=claude-opus-5-5
# EDITH_DAILY_TURN_LIMIT=200

# Optional admin account created on startup
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# GitHub OAuth Credentials (Obtain from GitHub Developer Settings -> OAuth Apps)
# Homepage URL: http://localhost:5173
# Authorization Callback URL: http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173

# Google OAuth Credentials (Obtain from Google Cloud Console -> APIs & Services -> Credentials)
# Authorized JavaScript Origins: http://localhost:5173
# Authorized Redirect URIs: http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173
